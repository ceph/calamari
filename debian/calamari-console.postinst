#!/bin/bash -e

set -x

calamari()
{
	d=$(pwd)
	# initialize database
	cd /opt/calamari/webapp/calamari
	../../venv/bin/python manage.py syncdb --noinput

	# set up calamari admin user
	echo "from django.contrib.auth.models import User; \
		User.objects.create_superuser(\
		'admin', 'calamari@inktank.com', 'admin')" | \
		../../venv/bin/python manage.py shell

	# allow apache access to all
	# rpm/centos: apache?
	chown -R www-data.www-data .
	# centos: ???
	a2dissite 000-default
	a2ensite calamari.conf
	a2ensite graphite.conf
	a2enmod proxy
	cd $d
}

graphite_seed()
{
	# prerm
	# make a random 'SECRET_KEY' (really a crypto seed) for graphite
	APP_SETTINGS=/opt/graphite/webapp/graphite/app_settings.py
	grep -s -q SECRET_KEY $APP_SETTINGS && return

	KEY=$(tr -dc _A-Z-a-z-0-9 < /dev/urandom | head -c50)
	echo "# key added by $0" >>$APP_SETTINGS
	echo "SECRET_KEY = \"$KEY\"" >>$APP_SETTINGS
}

graphite()
{
	d=$(pwd)
	cd /opt/graphite/webapp/graphite
	../../bin/python manage.py syncdb --noinput
	# rpm/centos: apache?
	chown -R www-data.www-data /opt/graphite/storage
	cd $d
}


carbon()
{
	d=$(pwd)
	cd /opt/graphite/conf
	sed -e 's/MAX_CREATES_PER_MINUTE = 50/MAX_CREATES_PER_MINUTE = 10000/' \
		<carbon.conf.example >carbon.conf

	# XXX are these necessary?
	cp storage-schemas.conf.example storage-schemas.conf
	cp storage-aggregation.conf.example storage-aggregation.conf
	cp relay-rules.conf.example relay-rules.conf
	cp aggregation-rules.conf.example aggregation-rules.conf

	cat >graphite.wsgi <<EOF
import os
import sys
import site

prev_sys_path = list(sys.path)
site.addsitedir('/opt/graphite/lib/python2.7/site-packages')

# Reorder sys.path so new directories at the front.
new_sys_path = []
for item in list(sys.path):
    if item not in prev_sys_path:
        new_sys_path.append(item)
        sys.path.remove(item)
sys.path[:0] = new_sys_path

EOF
	cat graphite.wsgi.example >> graphite.wsgi
	# init.d/carbon-cache handled in make install
	[ -d /var/log/carbon ] || mkdir /var/log/carbon
	/etc/init.d/carbon-cache restart
	# rpm/centos
	# service carbon-cache start
	# chkconfig carbon-cache on
	cd $d
}

kraken()
{
	restart kraken
}

case "$1" in
	configure)
		graphite_seed
		graphite
		carbon
		kraken
		calamari
		[ -x /usr/sbin/a2enmod ] && a2enmod headers
		service apache2 restart
		# rpm/centos
		# service httpd restart
		# chkconfig httpd on
		;;

	abort-upgrade|abort-remove|abort-deconfigure)
		;;
	*)
		echo "postinst called with unknown argument $1" >&2
		exit 1
		;;
esac


exit 0
